{
  // Revv shared TypeScript base. Every repo's tsconfig.json `extends` this file.
  // Rule: a repo may override module/lib/jsx/paths, but must never weaken `strict`
  // or `noUncheckedIndexedAccess` (tools/verify-foundation.mjs enforces this).
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Revv base",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "moduleDetection": "force",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "forceConsistentCasingInFileNames": true,
    "allowUnreachableCode": false,

    "noEmit": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  }
}
