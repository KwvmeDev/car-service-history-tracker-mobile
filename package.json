    "@react-native-google-signin/google-signin": "^16.1.5",
    "@react-native-ml-kit/text-recognition": "2.0.0",
    "@revv/tokens": "file:../revv-tokens",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-persist-client": "^5.102.8",
    "better-auth": "1.7.3",
    "expo": "~55.0.31",
    "expo-apple-authentication": "~55.0.17",
    "expo-constants": "~55.0.17",
