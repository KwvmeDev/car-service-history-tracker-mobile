    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "jest-expo": "55.0.22",
    "openapi-typescript": "^7.5.2",
    "patch-package": "^8.0.1",
    "prettier": "^3.4.2",
    "react-test-renderer": "19.2.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.1"
  },
  "overrides": {
    "react-dom": "19.2.0",
    "react-test-renderer": "19.2.0"
  },
