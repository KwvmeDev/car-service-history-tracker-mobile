{
  "expo": {
    "name": "Revv",
    "slug": "revv-mobile",
    "version": "0.1.0",
    "scheme": "revv",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.revv.app",
      "supportsTablet": false,
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.revv.app",
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-apple-authentication",
      "expo-font",
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "http://localhost:3000"
    }
  }
}
