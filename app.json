{
  "expo": {
    "name": "Revv",
    "slug": "revv-mobile",
    "version": "0.1.0",
    "scheme": "revv",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.revv.app",
      "supportsTablet": false,
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.revv.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-apple-authentication",
      "expo-font",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.966447608895-f3sd8lo8sq70ervr1e5g76k1rdr29eq4"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Revv needs photo access to attach receipts and photos to a service record.",
          "cameraPermission": "Revv needs the camera to photograph a receipt for a service record."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1D4ED8"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "http://localhost:3000",
      "googleWebClientId": "966447608895-qte3ugdo0o4akf8if47nbfgs19vqkkes.apps.googleusercontent.com",
      "googleIosClientId": "966447608895-f3sd8lo8sq70ervr1e5g76k1rdr29eq4.apps.googleusercontent.com"
    }
  }
}
