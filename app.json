{
  "expo": {
    "name": "Revv",
    "slug": "revv-mobile",
    "version": "0.1.0",
    "scheme": "revv",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.revv.app",
      "supportsTablet": false,
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.revv.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-apple-authentication",
      "expo-font",
      "@react-native-google-signin/google-signin",
      [
        "expo-image-picker",
        {
          "photosPermission": "Revv needs photo access to attach receipts and photos to a service record.",
          "cameraPermission": "Revv needs the camera to photograph a receipt for a service record."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0B1D33"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "http://localhost:3000"
    }
  }
}
